# Where the PESO backend is running. Defaults to http://localhost:3001 if unset,
# which is correct for local development (see ../backend/README.md).
# Copy this file to .env and change the value if you deploy the backend elsewhere.
VITE_API_BASE=http://localhost:3001

# Google Maps JavaScript API key for the employer vacancy map.
# Enable Maps JavaScript API and billing; restrict this browser key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
