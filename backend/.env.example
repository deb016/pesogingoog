# Copy this file to .env (or export these as real environment variables before
# running `node server.js`).

# ============ DATABASE (XAMPP MySQL/MariaDB) ============
# Defaults below match a stock XAMPP install (root user, no password, default
# port). Open the XAMPP Control Panel and click "Start" next to MySQL before
# starting this server. The "peso_db" database and all tables are created
# automatically the first time the server runs — no manual phpMyAdmin setup needed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peso_db

# ============ EMAIL (optional — via Brevo) ============
# The settings below enable real verification, password-reset, and profile-review
# notification emails, sent through Brevo's transactional email API (a plain HTTPS
# request, not SMTP — this is what makes it work on Vercel, where outbound SMTP
# connections aren't reliable).

# Your Brevo API key. Get one at https://app.brevo.com/settings/keys/api
# (Settings -> SMTP & API -> API Keys -> Generate a new API key). Starts with "xkeysib-".
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The FROM address — must be a verified sender in Brevo first:
# https://app.brevo.com/senders/list ("Senders, Domains & Dedicated IPs").
BREVO_SENDER_EMAIL=your-peso-account@gmail.com

# Display name for the FROM address (optional — defaults to "PESO Gingoog City").
# BREVO_SENDER_NAME=PESO Gingoog City

# Optional publicly accessible HTTPS URL for the logo shown inside emails.
# If omitted, the backend uses APP_BASE_URL/peso-logo.png.
# BREVO_LOGO_URL=https://your-project.example/peso-logo.png

# The URL where the FRONTEND is running — used to build the links inside the emails.
# When deployed on Vercel, set this to your deployed frontend's URL
# (e.g. https://your-project.vercel.app).
APP_BASE_URL=http://localhost:5173

# Optional: change the backend's own port (defaults to 3001).
# PORT=3001
